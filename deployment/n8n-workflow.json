{
  "name": "TRMNL Weeks - Codeberg Deploy",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trmnl-weeks-deploy",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "trmnl-weeks-deploy"
    },
    {
      "parameters": {
        "command": "=/home/antfarm/deployments/trmnl-weeks/deployment/deploy.sh"
      },
      "id": "execute-deploy",
      "name": "Execute Deploy Script",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [470, 300]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=Deployment triggered successfully at {{ $now.toISO() }}\n\nOutput:\n{{ $json.stdout }}\n\nErrors:\n{{ $json.stderr }}"
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [690, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Execute Deploy Script",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Deploy Script": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "versionId": "1",
  "id": "trmnl-weeks-deploy",
  "meta": {
    "instanceId": "your-n8n-instance-id"
  },
  "tags": [
    {
      "name": "deployment"
    },
    {
      "name": "codeberg"
    }
  ]
}
